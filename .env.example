# =============================================================
# Hudi Lab Portable —— 本地配置模板
# 首次执行 bootstrap 时会自动复制为 .env（.env 不进入 Git）
# =============================================================

# Compose 项目名，必须与 compose.yaml 的 name 一致
COMPOSE_PROJECT_NAME=hudi-lab-portable

# 宿主机端口（只绑定 127.0.0.1）
# 避开旧 hudi-lab 环境使用的 9000 / 9870 / 9864
NN_RPC_PORT=19000
NN_WEB_PORT=19870
DN_WEB_PORT=19864

# Spark + Hudi 镜像
# 默认使用 GHCR 上已发布的公共镜像（固定版本，可匿名拉取）。
# 需要完全本地构建时改成 hudi-lab-portable-spark:0.1.0，
# 并执行 docker compose build spark。
SPARK_IMAGE=ghcr.io/yangbin09/hudi-lab-spark:0.1.0
